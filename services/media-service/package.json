{
  "name": "@shopverse/media-service",
  "version": "1.0.0",
  "private": true,
  "description": "Presigned S3 uploads/downloads",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -b",
    "start": "node --enable-source-maps --import @shopverse/common/tracing dist/index.js",
    "dev": "tsx watch --import @shopverse/common/tracing src/index.ts",
    "lint": "eslint src test",
    "test": "vitest run --coverage",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1000.0",
    "@aws-sdk/s3-request-presigner": "^3.1000.0",
    "@shopverse/common": "1.0.0",
    "zod": "^4.6.0"
  }
}
