# Copy to .env (git-ignored). Values are read by JCasC (casc.yaml).
JENKINS_ADMIN_PASSWORD=change-me
JENKINS_URL=http://localhost:8085/
DOCKER_GID=999
AWS_ACCOUNT_ID=111122223333
AWS_REGION=ap-south-1
# instance-profile (Jenkins on EC2, default) | static-keys (Jenkins on a laptop: fill the two keys below)
AWS_AUTH_MODE=instance-profile
AWS_CI_ACCESS_KEY_ID=
AWS_CI_SECRET_ACCESS_KEY=
SONAR_TOKEN=
SONAR_DB_PASSWORD=change-me
GITHUB_OWNER=your-org
GITHUB_REPO=aws-microservices
GITHUB_USER=shopverse-ci
GITHUB_TOKEN=
