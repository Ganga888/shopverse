{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "ShopVerse microservice chart values",
  "type": "object",
  "required": ["global", "image", "containerPort", "resources", "probes"],
  "definitions": {
    "quantity": { "type": ["string", "integer", "number"], "pattern": "^[0-9.]+([numkKMGTPE]i?)?$" },
    "resourceList": {
      "type": "object",
      "required": ["cpu", "memory"],
      "properties": {
        "cpu": { "$ref": "#/definitions/quantity" },
        "memory": { "$ref": "#/definitions/quantity" }
      }
    },
    "probe": {
      "type": "object",
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "pattern": "^/" },
        "initialDelaySeconds": { "type": "integer", "minimum": 0 },
        "periodSeconds": { "type": "integer", "minimum": 1 },
        "timeoutSeconds": { "type": "integer", "minimum": 1 },
        "failureThreshold": { "type": "integer", "minimum": 1 }
      }
    }
  },
  "properties": {
    "nameOverride": { "type": "string" },
    "global": {
      "type": "object",
      "required": ["env", "domain", "awsAccountId", "awsRegion"],
      "properties": {
        "env": { "type": "string", "enum": ["dev", "staging", "prod"] },
        "domain": { "type": "string", "pattern": "^([a-z0-9-]+\\.)*ganga888\\.in$" },
        "awsAccountId": { "type": "string", "pattern": "^[0-9]{12}$" },
        "awsRegion": { "type": "string" },
        "partOf": { "type": "string" },
        "runbookBaseUrl": { "type": "string" }
      }
    },
    "image": {
      "type": "object",
      "required": ["tag"],
      "properties": {
        "repository": { "type": "string" },
        "tag": { "type": "string", "minLength": 1, "not": { "const": "latest" } },
        "digest": { "type": "string", "pattern": "^(sha256:[a-f0-9]{64})?$" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "imagePullSecrets": { "type": "array" },
    "replicaCount": { "type": "integer", "minimum": 0 },
    "containerPort": { "type": "integer", "const": 8080 },
    "service": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["ClusterIP"] },
        "port": { "type": "integer" },
        "annotations": { "type": "object" }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "host": { "type": "string" },
        "path": { "type": "string", "pattern": "^(/api/v1/[a-z-]+)?$" },
        "pathType": { "type": "string", "enum": ["Prefix", "Exact", "ImplementationSpecific"] },
        "annotations": { "type": "object" }
      }
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "irsa": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "roleArn": { "type": "string", "pattern": "^(arn:aws:iam::[0-9]{12}:role/shopverse-(dev|staging|prod)-[a-z0-9-]+)?$" }
          }
        },
        "annotations": { "type": "object" },
        "automountServiceAccountToken": { "type": "boolean" }
      }
    },
    "podSecurityContext": {
      "type": "object",
      "required": ["runAsNonRoot"],
      "properties": { "runAsNonRoot": { "const": true } }
    },
    "securityContext": {
      "type": "object",
      "required": ["allowPrivilegeEscalation", "readOnlyRootFilesystem", "capabilities"],
      "properties": {
        "allowPrivilegeEscalation": { "const": false },
        "readOnlyRootFilesystem": { "const": true },
        "runAsNonRoot": { "const": true }
      }
    },
    "resources": {
      "type": "object",
      "required": ["requests", "limits"],
      "properties": {
        "requests": { "$ref": "#/definitions/resourceList" },
        "limits": { "$ref": "#/definitions/resourceList" }
      }
    },
    "probes": {
      "type": "object",
      "required": ["liveness", "readiness", "startup"],
      "properties": {
        "liveness": { "$ref": "#/definitions/probe" },
        "readiness": { "$ref": "#/definitions/probe" },
        "startup": { "$ref": "#/definitions/probe" }
      }
    },
    "env": {
      "type": "object",
      "additionalProperties": { "type": ["string", "number", "boolean"] },
      "propertyNames": { "pattern": "^[A-Z_][A-Z0-9_]*$" }
    },
    "logLevel": { "type": "string", "enum": ["trace", "debug", "info", "warn", "error", "fatal"] },
    "nodeEnv": { "type": "string", "enum": ["development", "production", "test"] },
    "extraEnv": { "type": "array" },
    "externalSecrets": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "apiVersion": { "type": "string", "enum": ["external-secrets.io/v1", "external-secrets.io/v1beta1"] },
        "storeName": { "type": "string" },
        "storeKind": { "type": "string", "enum": ["ClusterSecretStore", "SecretStore"] },
        "refreshInterval": { "type": "string" },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "remoteKey", "keys"],
            "properties": {
              "name": { "type": "string", "pattern": "^[a-z0-9-]+$" },
              "remoteKey": { "type": "string", "pattern": "^(shopverse/(dev|staging|prod)/|AmazonMSK_shopverse_(dev|staging|prod)_)" },
              "refreshInterval": { "type": "string" },
              "keys": {
                "type": "object",
                "minProperties": 1,
                "propertyNames": { "pattern": "^[A-Z_][A-Z0-9_]*$" },
                "additionalProperties": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "topologySpread": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "zoneWhenUnsatisfiable": { "enum": ["DoNotSchedule", "ScheduleAnyway"] },
        "hostWhenUnsatisfiable": { "enum": ["DoNotSchedule", "ScheduleAnyway"] },
        "maxSkew": { "type": "integer", "minimum": 1 }
      }
    },
    "autoscaling": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "minReplicas": { "type": "integer", "minimum": 1 },
        "maxReplicas": { "type": "integer", "minimum": 1 },
        "targetCPUUtilizationPercentage": { "type": "integer", "minimum": 1, "maximum": 100 },
        "targetMemoryUtilizationPercentage": { "type": ["integer", "null"], "minimum": 1, "maximum": 100 },
        "behavior": { "type": "object" }
      }
    },
    "keda": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "minReplicaCount": { "type": "integer", "minimum": 0 },
        "maxReplicaCount": { "type": "integer", "minimum": 1 },
        "pollingInterval": { "type": "integer" },
        "cooldownPeriod": { "type": "integer" },
        "bootstrapServers": { "type": "string" },
        "consumerGroup": { "type": "string" },
        "topics": {
          "type": "array",
          "items": { "type": "string", "pattern": "^(users|catalog|orders|inventory|payments|shipping|reviews)\\.(events|commands)(\\.dlq)?$" }
        },
        "lagThreshold": { "type": ["string", "integer"] },
        "activationLagThreshold": { "type": ["string", "integer"] },
        "offsetResetPolicy": { "enum": ["earliest", "latest"] },
        "tls": { "type": "boolean" },
        "bootstrapServersFromEnv": { "type": "boolean" },
        "sasl": { "enum": ["", "scram_sha256", "scram_sha512"] },
        "saslSecretItem": { "type": "string" },
        "cpuTrigger": { "type": "boolean" },
        "memoryTrigger": { "type": "boolean" }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "minAvailable": { "type": ["integer", "string"] }
      }
    },
    "rollout": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "trafficRouting": { "enum": ["nginx", "none"] },
        "steps": { "type": "array", "minItems": 1 },
        "analysis": {
          "type": "object",
          "properties": {
            "prometheusAddress": { "type": "string" },
            "successRateThreshold": { "type": "number", "minimum": 0, "maximum": 1 },
            "p95LatencyThreshold": { "type": "number", "exclusiveMinimum": 0 },
            "interval": { "type": "string" },
            "count": { "type": "integer" },
            "failureLimit": { "type": "integer" }
          }
        }
      }
    },
    "metrics": { "type": "object" },
    "prometheusRule": { "type": "object" },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "allowIngressNginx": { "type": "boolean" },
        "allowFromAllShopPods": { "type": "boolean" },
        "callers": { "type": "array", "items": { "type": "string", "pattern": "^[a-z-]+-service$" } },
        "egressToServices": { "type": "array", "items": { "type": "string", "pattern": "^[a-z-]+-service$" } },
        "egress": { "type": "object" },
        "datastorePeers": { "type": "array" },
        "extraIngress": { "type": "array" },
        "extraEgress": { "type": "array" }
      }
    },
    "migration": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "command": { "type": "array", "items": { "type": "string" } },
        "args": { "type": "array" }
      }
    }
  }
}
