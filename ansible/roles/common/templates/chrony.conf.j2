# {{ ansible_managed }}
{% for s in common_ntp_servers %}
server {{ s }}
{% endfor %}
{% for p in common_ntp_pools %}
pool {{ p }}
{% endfor %}
keyfile /etc/chrony/chrony.keys
driftfile /var/lib/chrony/chrony.drift
ntsdumpdir /var/lib/chrony
logdir /var/log/chrony
maxupdateskew 100.0
rtcsync
makestep 1 3
leapsectz right/UTC
# client only - never serve time
port 0
cmdport 0
