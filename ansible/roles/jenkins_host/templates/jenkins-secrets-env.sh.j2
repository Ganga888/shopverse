#!/usr/bin/env bash
# {{ ansible_managed }}
# Writes {{ jenkins_install_dir }}/.env.secrets from Secrets Manager ({{ jenkins_secret_id }}) using the
# EC2 instance role. Run again (then `docker compose ... up -d`) after rotating a value in Secrets Manager.
set -euo pipefail
dest="{{ jenkins_install_dir }}/.env.secrets"
tmp="$(mktemp)"
trap 'rm -f "$tmp"' EXIT
/usr/local/bin/aws secretsmanager get-secret-value \
  --region "{{ aws_region | default('ap-south-1') }}" \
  --secret-id "{{ jenkins_secret_id }}" \
  --query SecretString --output text \
  | jq -r 'to_entries[] | "\(.key)=\(.value)"' > "$tmp"
chmod 0600 "$tmp"
if [[ -f "$dest" ]] && cmp -s "$tmp" "$dest"; then
  echo "unchanged"
else
  install -m 0600 -o root -g root "$tmp" "$dest"
  echo "changed"
fi
