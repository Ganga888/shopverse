#!/usr/bin/env bash
# {{ ansible_managed }}
set -euo pipefail
ts=$(date -u +%Y%m%dT%H%M%SZ)
archive=/tmp/jenkins_home-${ts}.tar.gz
# Exclude caches and workspaces; keep config, jobs, credentials (encrypted with secrets/master.key)
tar -C "{{ jenkins_home_dir }}" \
    --exclude='./workspace' --exclude='./caches' --exclude='./.cache' --exclude='./logs' \
    -czf "$archive" .
/usr/local/bin/aws s3 cp "$archive" "s3://{{ jenkins_backup_bucket }}/{{ jenkins_backup_prefix }}/jenkins_home-${ts}.tar.gz" \
    --sse aws:kms --only-show-errors
rm -f "$archive"
echo "$(date -u) backup ok: ${ts}"
