# Alertmanager configuration TEMPLATE.
# Rendered by External Secrets Operator (ExternalSecret monitoring/alertmanager-shopverse, engine v2):
# the dot-prefixed placeholders below (slack_webhook_url etc.) are filled from AWS Secrets Manager shopverse/<env>/monitoring/alertmanager
#   slack_webhook_url  - Slack incoming webhook (channel per env, e.g. #shopverse-prod-alerts)
#   smtp_username      - SES SMTP credentials
#   smtp_password
#   email_to           - on-call distribution list
# The result is the Secret "alertmanager-shopverse" referenced by alertmanagerSpec.configSecret.
# NOTE: this file must not contain any other Go-template braces - Slack/email message templates live in
# shopverse.tmpl (mounted from ConfigMap alertmanager-templates) and override the default template names.
global:
  resolve_timeout: 5m
  slack_api_url: '{{ .slack_webhook_url }}'
  smtp_smarthost: email-smtp.ap-south-1.amazonaws.com:587
  smtp_from: alerts@ganga888.in
  smtp_auth_username: '{{ .smtp_username }}'
  smtp_auth_password: '{{ .smtp_password }}'
  smtp_require_tls: true

templates:
  - /etc/alertmanager/configmaps/alertmanager-templates/*.tmpl

route:
  receiver: slack-default
  group_by: [alertname, namespace, service, job]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
  routes:
    # Dead-man's switch from kube-prometheus-stack - route to a null receiver (wire to a heartbeat service if used)
    - receiver: "null"
      matchers: [alertname = "Watchdog"]
    - receiver: "null"
      matchers: [alertname = "InfoInhibitor"]
    # Pages: critical alerts go to Slack AND email, repeat hourly until resolved.
    - receiver: slack-and-email-critical
      matchers: [severity = "critical"]
      repeat_interval: 1h
      continue: false
    # SLO slow-burn / warnings: Slack only.
    - receiver: slack-default
      matchers: [severity = "warning"]
    - receiver: "null"
      matchers: [severity = "none"]

inhibit_rules:
  # A firing critical alert silences the matching warning for the same service.
  - source_matchers: [severity = "critical"]
    target_matchers: [severity = "warning"]
    equal: [alertname, namespace, service]
  # Fast burn implies slow burn.
  - source_matchers: [alertname = "SLOErrorBudgetBurnFast"]
    target_matchers: [alertname = "SLOErrorBudgetBurnSlow"]
    equal: [job]
  # Node down explains everything scheduled on it.
  - source_matchers: [alertname = "NodeNotReady"]
    target_matchers: [alertname =~ "PodCrashLooping|.*NoReadyPods"]

receivers:
  - name: "null"
  - name: slack-default
    slack_configs:
      - send_resolved: true
        # title/text come from slack.default.title / slack.default.text overridden in shopverse.tmpl
  - name: slack-and-email-critical
    slack_configs:
      - send_resolved: true
    email_configs:
      - to: '{{ .email_to }}'
        send_resolved: true
